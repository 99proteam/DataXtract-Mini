# =================================
# Data Extractor Pro Configuration
# =================================
# Copy this file to .env and configure your settings
# All settings are optional unless noted

# Server Configuration
PORT=3000
NODE_ENV=production

# =================================
# Proxy Settings (Optional)
# =================================
# Enable proxy rotation for Google Maps extraction
PROXY_ENABLED=false
# Get your API key from https://webshare.io
WEBSHARE_API_KEY=

# =================================
# Email Marketing (SMTP)
# =================================
# Required for Email Campaigns feature
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# =================================
# SMS Marketing (Twilio)
# =================================
# Required for SMS Campaigns feature
# Get credentials from https://www.twilio.com/console
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# =================================
# AI Integration (Optional)
# =================================
# Supports OpenAI and Google Gemini
AI_PROVIDER=openai
AI_API_KEY=
# OpenAI base URL (default: https://api.openai.com/v1)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo
# For Google Gemini
AI_GEMINI_MODEL=gemini-1.5-flash

# =================================
# Email Verification (Optional)
# =================================
# ZeroBounce API for email validation
# Get your key from https://www.zerobounce.net
ZEROBOUNCE_API_KEY=
